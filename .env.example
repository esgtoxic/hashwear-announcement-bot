DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Recommended: your Hashwear Discord server ID. Guild commands appear immediately.
# Leave blank only if you intentionally want /announce registered globally.
DISCORD_GUILD_ID=

# Optional comma-separated role IDs allowed to use /announce.
# Administrators and users with Manage Messages are always allowed.
ANNOUNCER_ROLE_IDS=

BRAND_NAME=Hashwear
DEFAULT_EMBED_COLOR=#111111
