DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Recommended while testing. Commands register instantly in this server.
# Remove it later if you want the command registered globally.
DISCORD_GUILD_ID=

# Optional: comma-separated Discord role IDs allowed to use /announce.
# Example: 123456789012345678,987654321098765432
# If blank, users need Manage Messages or Administrator permission.
ANNOUNCER_ROLE_IDS=

# Optional branding
BRAND_NAME=Hashwear
DEFAULT_EMBED_COLOR=#111111
